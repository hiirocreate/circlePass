# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Login / LINE Mini App
# NEXT_PUBLIC_LIFF_ID と LINE_CHANNEL_ID の2つが必須です。
# LINE_CHANNEL_ACCESS_TOKEN は任意(店舗ごとのトークン未登録時の予備。空欄でも動作します)。
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SaaS利用料(店舗→運営)のStripe価格ID。scripts/create-saas-plans.ts の出力を設定する
STRIPE_SAAS_PRICE_LIGHT=
STRIPE_SAAS_PRICE_STANDARD=
STRIPE_SAAS_PRICE_PREMIUM=

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
JWT_SECRET=change-me-to-a-long-random-string
